# Template file for 'voyage'
pkgname=voyage
version=0.3.0
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="gtk4-devel glib-devel"
depends="polkit parted gptfdisk efibootmgr dosfstools e2fsprogs xmirror"
short_desc="GTK4 installer for Void Linux built on the void-installer backend"
maintainer="gui <mendescotta@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/mendescotta/voyage"
distfiles="https://github.com/mendescotta/voyage/archive/refs/tags/v${version}.tar.gz"
checksum=b30667ef017af3a0a345137c301dd80aebddc0f51ae850f4a36d92c57ec31a37

do_install() {
	vbin target/${RUST_TARGET}/release/voyage
	vmkdir usr/share/voyage
	vcopy resources/backend usr/share/voyage
	chmod 755 ${DESTDIR}/usr/share/voyage/backend/*.sh
	vinstall resources/data/org.voidlinux.voyage.desktop 644 usr/share/applications
	vinstall resources/images/voyage.svg 644 usr/share/icons/hicolor/scalable/apps org.voidlinux.voyage.svg
}
