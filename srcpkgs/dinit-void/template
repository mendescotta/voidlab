# Template file for 'dinit-void'
pkgname=dinit-void
reverts="0.99.25_1 0.99.25_2 0.99.25_3 0.99.25_4 0.99.25_5 0.99.25_6 0.99.25_7 0.99.25_8 0.99.25_9 0.99.25_10"
version=0.1.1
revision=1
# Void's boot on dinit (mendescotta/dinit-void): void-runit's early boot and shutdown as dinit
# services, plus the services for Void's daemons. 0.1 replaces the dinit-chimera based 0.99.25
# builds (hence reverts, which 0.1.x still needs: it sorts below 0.99.25); nothing from Chimera is used.
build_style=gnu-makefile
make_install_target="install install-init"
hostmakedepends="pkg-config"
makedepends="dbus-devel"
# Two flavours of the same files:
#  - dinit-void: the dinit distro (ISOs, vessel installs). dinit is PID 1 and it owns
#    /usr/bin/{init,shutdown,halt,poweroff,reboot,soft-reboot}, like runit-void.
#  - dinit-void-core: the lab flavour for a runit host. It leaves out those commands and ships the
#    glue to boot dinit from a second boot entry (dinit-alongside-init, tools/dinit-alongside).
# They conflict; never install both.
depends="dinit eudev kmod kbd util-linux iproute2 procps-ng"
short_desc="Void Linux boot, shutdown and daemon services for dinit"
maintainer="mendescotta <mendescotta@gmail.com>"
license="BSD-2-Clause, Apache-2.0, Public Domain"
homepage="https://github.com/mendescotta/dinit-void"
distfiles="https://github.com/mendescotta/dinit-void/archive/v${version}.tar.gz"
checksum=679623491ec3b6fd180ce976d5e7ce67336b470b5029d207621c023716c1b95a
conflicts="runit-void>=0 dinit-void-core>=0"
make_dirs="/etc/dinit.d/boot.d 0755 root root"

post_install() {
	vlicense COPYING
	vlicense LICENSES/BSD-2-Clause-OpenRC
	vlicense LICENSES/BSD-2-Clause-Artix
}

dinit-void-core_package() {
	short_desc+=" - lab flavour for a runit host (no init or power commands)"
	depends="dinit eudev kmod kbd util-linux iproute2 procps-ng"
	conflicts="dinit-void>=0"
	make_dirs="/etc/dinit.d/boot.d 0755 root root"
	pkg_install() {
		local d f
		# a copy of everything dinit-void ships, minus what runit-void owns
		for d in etc usr; do
			vmkdir $d
			cp -a ${DESTDIR}/$d/. ${PKGDESTDIR}/$d/
		done
		for f in init shutdown halt poweroff reboot soft-reboot; do
			rm -f ${PKGDESTDIR}/usr/bin/$f
		done
		rm -f ${PKGDESTDIR}/etc/profile.d/editor.sh
		make DESTDIR=${PKGDESTDIR} install-alongside
	}
}
