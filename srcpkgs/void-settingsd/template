# Template file for 'void-settingsd'
pkgname=void-settingsd
version=0.2.0
revision=1
build_style=cargo
depends="dbus polkit tzdata"
short_desc="hostname1, timedate1 and locale1 D-Bus services and ctl wrappers"
maintainer="gui <mendescotta@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/mendescotta/void-settingsd"
distfiles="https://github.com/mendescotta/void-settingsd/archive/v${version}.tar.gz>void-settingsd-${version}.tar.gz"
checksum=19d342aa0e30d703e95d7d6b97a0366788dfd807936a3232b6830df9c8fcccde

do_install() {
	vinstall target/${RUST_TARGET}/release/void-settingsd 755 usr/libexec
	vbin target/${RUST_TARGET}/release/void-settingsctl
	for n in timedatectl hostnamectl localectl; do
		ln -s void-settingsctl ${DESTDIR}/usr/bin/${n}
	done
	vinstall data/org.freedesktop.settingsd.conf 644 usr/share/dbus-1/system.d
	vinstall data/org.freedesktop.settingsd.policy 644 usr/share/polkit-1/actions
	for n in hostname1 timedate1 locale1; do
		vinstall data/org.freedesktop.${n}.service 644 usr/share/dbus-1/system-services
	done
}
