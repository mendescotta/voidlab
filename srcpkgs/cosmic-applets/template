# Template file for 'cosmic-applets'
pkgname=cosmic-applets
version=1.9.0
revision=1
archs="x86_64*"
build_style=cargo
configure_args="--workspace"
hostmakedepends="pkg-config just $(vopt_if sccache "rust-sccache")"
makedepends="libxkbcommon-devel eudev-libudev-devel dbus-devel pulseaudio-devel libinput-devel pipewire-devel clang22-devel"
depends="cosmic-icons dbus-libs eudev-libudev lame libinput libpipewire libpulseaudio libxkbcommon libsndfile libxcb libasyncns libflac libvorbis libogg libmpg123 libXau libXdmcp opus"
short_desc="Applets for COSMIC"
maintainer="Bella109 <belladev109@proton.me>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-applets"
distfiles="https://github.com/pop-os/cosmic-applets/archive/refs/tags/epoch-${version}.tar.gz"
checksum=f113f74cd05b179ab0478dd5876b671880914600d5df56d518f8f80c08543037
build_options="sccache"

pre_build() {
	$(vopt_if sccache "export RUSTC_WRAPPER=/usr/bin/sccache")
}

do_install() {
	just rootdir=${DESTDIR} target="${RUST_TARGET}/release" install
}
