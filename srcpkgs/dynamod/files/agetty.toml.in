# Void: agetty from util-linux (upstream's default points at busybox's
# /sbin/getty, which Void doesn't ship).
[service]
name = "agetty-@TTY@"
exec = ["/usr/bin/agetty", "--noclear", @EXTRA@"@TTY@", "@BAUD@", "@TERM@"]
type = "simple"

[restart]
policy = "permanent"
delay = "1s"
max-restarts = 10
max-restart-window = "30s"

[dependencies]
after = ["bootmisc", "udev-coldplug"]

[readiness]
type = "none"

[shutdown]
stop-signal = "SIGHUP"
stop-timeout = "3s"
