# Template file for 'dinit'
pkgname=dinit
version=0.22.1
revision=1
build_style=configure
# shutdown/halt/reboot/poweroff get a dinit- prefix so this package can sit
# next to runit-void; dinit-void provides the unprefixed names.
configure_args="--prefix=/usr --sbindir=/usr/bin --mandir=/usr/share/man
 --platform=Linux --disable-strip --enable-shutdown --shutdown-prefix=dinit-
 --syscontrolsocket=/run/dinitctl"
hostmakedepends="m4"
makedepends="libcap-devel"
short_desc="Service manager and init system"
maintainer="mendescotta <mendescotta@gmail.com>"
license="Apache-2.0"
homepage="https://davmac.org/projects/dinit/"
distfiles="https://github.com/davmac314/dinit/archive/v${version}.tar.gz"
checksum=8907d4f668259c4f66d9d2c7cbbb55d455c28dc433596ab29005d589cb572e1e

post_install() {
	vlicense LICENSE
	vcompletion contrib/shell-completion/bash/dinitctl bash dinitctl
	vcompletion contrib/shell-completion/fish/dinitctl.fish fish dinitctl
	vcompletion contrib/shell-completion/zsh/_dinit zsh dinitctl
}
