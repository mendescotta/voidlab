+
+/*
+ * This is the runit equivalent of leader-systemd.c: it is exec'd by
+ * leader-main.c (as gnome-session-init-worker) once the session's D-Bus
+ * activation environment has been exported. Where the systemd leader asks
+ * systemd --user to activate gnome-session@<name>.target and lets unit
+ * dependencies pull in gnome-shell/gsd/etc, there is no per-user init
+ * manager here to delegate to, so this leader supervises those processes
+ * itself via a small runit tree (runsvdir -P). The service definitions
+ * are shipped under LIBEXECDIR/gnome-session/runit-services, but runsv
+ * needs a writable supervise/ directory next to each run script, so every
+ * session supervises a private copy under $XDG_RUNTIME_DIR whose run
+ * scripts are symlinks back to the shipped ones.
+ *
+ * The gnome-session-leader-fifo protocol is kept for compatibility with
+ * anything that still expects it (e.g. a future gnome-session-monitor
+ * equivalent, or GDM's own session-end detection), but nothing in this
+ * package currently reads the far end -- the write is best-effort.
+ */
+
+#include <config.h>
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <glib.h>
+#include <glib-unix.h>
+#include <gio/gio.h>
+
+#include "gsm-util.h"
+
+#define RUNIT_TEMPLATE_DIR (LIBEXECDIR "/gnome-session/runit-services")
+/* Optional per-session profiles: RUNIT_SESSIONS_DIR/<session> lists the
+ * services (one per line) that session runs, standing in for the
+ * per-session systemd targets (e.g. gdm's gnome-session@gnome-login.target
+ * drop-in). Sessions without a profile run every shipped service. */
+#define RUNIT_SESSIONS_DIR (LIBEXECDIR "/gnome-session/runit-sessions")
+#define SV_DOWN_TIMEOUT_SECS "5"
+
+typedef struct {
+        GMainLoop *loop;
+        GPid       runsvdir_pid;
+        char      *service_dir;
+        int        fifo_fd;
+        gboolean   tearing_down;
+} Leader;
+
+static void
+leader_clear (Leader *ctx)
+{
+        g_clear_pointer (&ctx->loop, g_main_loop_unref);
+        g_clear_pointer (&ctx->service_dir, g_free);
+        if (ctx->fifo_fd >= 0)
+                g_close (ctx->fifo_fd, NULL);
+}
+
+G_DEFINE_AUTO_CLEANUP_CLEAR_FUNC (Leader, leader_clear);
+
+static void
+child_setsid (gpointer user_data)
+{
+        /* Give runsvdir its own process group so we can signal the whole
+         * supervision tree (runsvdir + runsv children) as a unit if a
+         * plain per-service teardown doesn't finish in time. */
+        setsid ();
+}
+
+/* Ask runsv to take each service down (waiting up to SV_DOWN_TIMEOUT_SECS
+ * per service) before tearing down the supervisor itself. Best-effort: a
+ * service directory that isn't running yet or has no runsv controlling it
+ * is simply skipped by `sv`. */
+static void
+stop_all_services (Leader *ctx)
+{
+        g_autoptr (GDir) dir = NULL;
+        const char *name;
+
+        dir = g_dir_open (ctx->service_dir, 0, NULL);
+        if (dir == NULL)
+                return;
+
+        while ((name = g_dir_read_name (dir))) {
+                g_autofree char *service_path = NULL;
+                g_autoptr (GError) error = NULL;
+                gchar *argv[] = { "sv", "-w", SV_DOWN_TIMEOUT_SECS, "down", NULL, NULL };
+
+                service_path = g_build_filename (ctx->service_dir, name, NULL);
+                argv[4] = service_path;
+
+                if (!g_spawn_sync (NULL, argv, NULL, G_SPAWN_SEARCH_PATH,
+                                   NULL, NULL, NULL, NULL, NULL, &error))
+                        g_debug ("Couldn't run `sv down` for %s: %s", name, error->message);
+        }
+}
+
+static void
+teardown_session (Leader *ctx)
+{
+        if (ctx->tearing_down || ctx->runsvdir_pid <= 0)
+                return;
+        ctx->tearing_down = TRUE;
+
+        g_debug ("Tearing down session services");
+        stop_all_services (ctx);
+
+        /* runsvdir exits immediately on TERM, orphaning every runsv; HUP
+         * makes it TERM each runsv (and so each service) before exiting. */
+        kill (ctx->runsvdir_pid, SIGHUP);
+}
+
+static gboolean
+leader_term_or_int_signal_cb (gpointer data)
+{
+        Leader *ctx = data;
+
+        g_debug ("Session termination requested");
+        teardown_session (ctx);
+
+        if (ctx->fifo_fd >= 0 && write (ctx->fifo_fd, "S", 1) < 0)
+                g_debug ("No monitor listening on leader FIFO: %m");
+
+        return G_SOURCE_REMOVE;
+}
+
+static void
+runsvdir_watch_cb (GPid pid, gint status, gpointer data)
+{
+        Leader *ctx = data;
+
+        g_debug ("runsvdir (pid %d) exited, ending session", (int) pid);
+        g_spawn_close_pid (pid);
+        ctx->runsvdir_pid = 0;
+        g_main_loop_quit (ctx->loop);
+}
+
+/* Build this session's private runit tree: one directory per shipped
+ * service, each holding symlinks to the shipped run (and, if present,
+ * finish) scripts, so runsv can create its supervise/ state in a location
+ * the user can write to. Any tree left behind by a previous session is
+ * removed first. */
+static GHashTable *
+load_session_profile (const char *session_name)
+{
+        g_autofree char *path = NULL;
+        g_autofree char *contents = NULL;
+        g_auto (GStrv) lines = NULL;
+        g_autoptr (GError) error = NULL;
+        GHashTable *services;
+
+        path = g_build_filename (RUNIT_SESSIONS_DIR, session_name, NULL);
+        if (!g_file_get_contents (path, &contents, NULL, &error)) {
+                if (!g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+                        g_warning ("Failed to read session profile %s: %s", path, error->message);
+                return NULL;
+        }
+
+        services = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+        lines = g_strsplit (contents, "\n", -1);
+        for (char **l = lines; *l; l++) {
+                char *name = g_strstrip (*l);
+
+                if (*name == '\0' || *name == '#')
+                        continue;
+                g_hash_table_add (services, g_strdup (name));
+        }
+
+        return services;
+}
+
+static char *
+setup_service_dir (const char *session_name)
+{
+        g_autoptr (GHashTable) profile = NULL;
+        g_autoptr (GDir) dir = NULL;
+        g_autoptr (GError) error = NULL;
+        g_autofree char *parent = NULL;
+        char *service_dir;
+        const char *name;
+        gchar *rm_argv[] = { "rm", "-rf", NULL, NULL };
+
+        parent = g_build_filename (g_get_user_runtime_dir (), "gnome-session", NULL);
+        service_dir = g_build_filename (parent, "runit", NULL);
+
+        rm_argv[2] = service_dir;
+        if (!g_spawn_sync (NULL, rm_argv, NULL, G_SPAWN_SEARCH_PATH,
+                           NULL, NULL, NULL, NULL, NULL, &error))
+                g_error ("Failed to clear stale runit tree %s: %s", service_dir, error->message);
+
+        if (g_mkdir_with_parents (service_dir, 0700) < 0)
+                g_error ("Failed to create runit tree %s: %m", service_dir);
+
+        profile = load_session_profile (session_name);
+
+        dir = g_dir_open (RUNIT_TEMPLATE_DIR, 0, &error);
+        if (dir == NULL)
+                g_error ("Runit service directory %s is missing: %s", RUNIT_TEMPLATE_DIR, error->message);
+
+        while ((name = g_dir_read_name (dir))) {
+                g_autofree char *svc = g_build_filename (service_dir, name, NULL);
+                g_autofree char *target = g_build_filename (RUNIT_TEMPLATE_DIR, name, "run", NULL);
+                g_autofree char *link = g_build_filename (svc, "run", NULL);
+
+                if (profile != NULL && !g_hash_table_remove (profile, name))
+                        continue;
+                if (!g_file_test (target, G_FILE_TEST_IS_EXECUTABLE))
+                        continue;
+                if (g_mkdir (svc, 0700) < 0 || symlink (target, link) < 0)
+                        g_error ("Failed to set up runit service %s: %m", name);
+
+                g_free (target);
+                g_free (link);
+                target = g_build_filename (RUNIT_TEMPLATE_DIR, name, "finish", NULL);
+                link = g_build_filename (svc, "finish", NULL);
+                if (g_file_test (target, G_FILE_TEST_IS_EXECUTABLE) &&
+                    symlink (target, link) < 0)
+                        g_error ("Failed to set up runit finish script for %s: %m", name);
+        }
+
+        if (profile != NULL) {
+                GHashTableIter iter;
+                const char *missing;
+
+                g_hash_table_iter_init (&iter, profile);
+                while (g_hash_table_iter_next (&iter, (gpointer *) &missing, NULL))
+                        g_warning ("Session %s lists unknown runit service %s", session_name, missing);
+        }
+
+        return service_dir;
+}
+
+int
+main (int argc, char **argv)
+{
+        g_autoptr (GError) error = NULL;
+        g_auto (Leader) ctx = { .fifo_fd = -1 };
+        g_autofree char *session_name = NULL;
+        const char *debug_string = NULL;
+        g_autofree char *fifo_path = NULL;
+        struct stat statbuf;
+        gchar *runsvdir_argv[] = { "runsvdir", "-P", NULL, NULL };
+
+        if (argc < 2)
+                g_error ("No session name was specified");
+        session_name = g_strdup (argv[1]);
+
+        debug_string = g_getenv ("GNOME_SESSION_DEBUG");
+        if (debug_string != NULL)
+                g_log_set_debug_enabled (atoi (debug_string) == 1);
+
+        gsm_util_export_activation_environment (&error);
+        if (error)
+                g_warning ("Failed to upload environment to DBus: %s", error->message);
+        g_clear_error (&error);
+
+        /* Session's own run scripts read this to know which components
+         * to launch (e.g. which gnome-session-service --session=). */
+        g_setenv ("GNOME_SESSION_NAME", session_name, TRUE);
+
+        /* gnome-session-service's finish script SIGTERMs us when the
+         * service exits cleanly (logout), standing in for systemd tearing
+         * down gnome-session.target when gnome-session-manager@ stops. */
+        g_autofree char *leader_pid = g_strdup_printf ("%d", (int) getpid ());
+        g_setenv ("GNOME_SESSION_LEADER_PID", leader_pid, TRUE);
+
+        ctx.loop = g_main_loop_new (NULL, TRUE);
+
+        fifo_path = g_build_filename (g_get_user_runtime_dir (),
+                                      "gnome-session-leader-fifo",
+                                      NULL);
+        if (mkfifo (fifo_path, 0666) < 0 && errno != EEXIST)
+                g_warning ("Failed to create leader FIFO: %m");
+
+        ctx.fifo_fd = g_open (fifo_path, O_WRONLY | O_NONBLOCK | O_CLOEXEC, 0666);
+        if (ctx.fifo_fd < 0)
+                g_debug ("No leader FIFO reader yet, continuing without one: %m");
+        else if (fstat (ctx.fifo_fd, &statbuf) == 0 && !(statbuf.st_mode & S_IFIFO))
+                g_warning ("Leader FIFO path is not a FIFO, ignoring it");
+
+        ctx.service_dir = setup_service_dir (session_name);
+        runsvdir_argv[2] = ctx.service_dir;
+
+        if (!g_spawn_async (NULL, runsvdir_argv, NULL,
+                            G_SPAWN_DO_NOT_REAP_CHILD | G_SPAWN_SEARCH_PATH,
+                            child_setsid, NULL, &ctx.runsvdir_pid, &error))
+                g_error ("Failed to start runit session supervisor: %s", error->message);
+
+        g_message ("Starting GNOME session (session: %s) under runit at %s",
+                   session_name, ctx.service_dir);
+
+        g_child_watch_add (ctx.runsvdir_pid, runsvdir_watch_cb, &ctx);
+
+        g_unix_signal_add (SIGHUP, leader_term_or_int_signal_cb, &ctx);
+        g_unix_signal_add (SIGTERM, leader_term_or_int_signal_cb, &ctx);
+        g_unix_signal_add (SIGINT, leader_term_or_int_signal_cb, &ctx);
+
+        g_main_loop_run (ctx.loop);
+        return 0;
+}
