#!/bin/sh
# Started by leader-runit.c under runsvdir -P. Inherits the session's
# D-Bus activation environment (DBUS_SESSION_BUS_ADDRESS, XDG_RUNTIME_DIR,
# GNOME_SESSION_NAME, etc) from the leader that exec'd runsvdir.
exec 2>&1
exec /usr/libexec/gnome-session-service --session="${GNOME_SESSION_NAME:-gnome}"
