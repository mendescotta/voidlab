# Template file for 'yelp'
# keep up to date with yelp-xsl
pkgname=yelp
version=49.2
revision=1
build_style=meson
hostmakedepends="gettext glib-devel itstool pkg-config"
makedepends="bzip2-devel gtk4-devel libadwaita-devel libglib-devel liblzma-devel
 libxml2-devel libxslt-devel sqlite-devel libwebkitgtk60-devel yelp-xsl"
depends="dconf desktop-file-utils hicolor-icon-theme yelp-xsl"
short_desc="Help browser for GNOME desktop"
maintainer="Érico Nogueira <ericonr@disroot.org>"
license="GPL-2.0-or-later"
homepage="https://wiki.gnome.org/Apps/Yelp"
# change this when it moves to a new major release
changelog="https://gitlab.gnome.org/GNOME/yelp/-/raw/master/NEWS"
distfiles="${GNOME_SITE}/yelp/${version%.*}/yelp-${version}.tar.xz"
checksum=5afc8e77308451ee45ee919efee5a154ca3c153a90e2a1b58cebf7827ab88ad0

yelp-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
	}
}
