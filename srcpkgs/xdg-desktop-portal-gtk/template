# Second build with -Dsession-only (patches/session-only.patch): only the
# Inhibit and Email portals, which need no GTK, linked against glib/gio.
post_build() {
	local args="--prefix=/usr --libdir=/usr/lib${XBPS_TARGET_WORDSIZE}
	 --libexecdir=/usr/libexec --bindir=/usr/bin --datadir=/usr/share
	 --localedir=/usr/share/locale --sysconfdir=/etc --localstatedir=/var
	 --buildtype=plain --auto-features=auto --wrap-mode=nodownload
	 -Db_lto=true -Db_ndebug=true -Db_staticpic=true
	 -Dsession-only=true -Dwallpaper=disabled -Dsettings=disabled
	 -Dappchooser=disabled -Dlockdown=disabled"
	if [ "$CROSS_BUILD" ]; then
		args+=" --cross-file=${XBPS_WRAPPERDIR}/meson/xbps_meson.cross"
	fi
	AR=gcc-ar meson setup $args . build-session
	ninja -C build-session ${makejobs}
}

post_install() {
	DESTDIR=${wrksrc}/session-destdir ninja -C build-session install
}

xdg-desktop-portal-gtk-session_package() {
	short_desc="Inhibit and Email portal backends for GNOME (no GTK)"
	depends="xdg-desktop-portal"
	conflicts="xdg-desktop-portal-gtk>=0"
	replaces="xdg-desktop-portal-gtk>=0"
	pkg_install() {
		vmkdir usr
		cp -a ${wrksrc}/session-destdir/usr/* ${PKGDESTDIR}/usr/
	}
}
