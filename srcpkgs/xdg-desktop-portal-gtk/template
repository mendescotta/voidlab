revision=5
build_style=meson
hostmakedepends="pkg-config gettext gnome-desktop-devel glib-devel xdg-desktop-portal"
makedepends="flatpak-devel gtk+3-devel libglib-devel
 xdg-desktop-portal gsettings-desktop-schemas-devel fontconfig-devel
 gnome-desktop-devel"
depends="xdg-desktop-portal gsettings-desktop-schemas"
conflicts="xdg-desktop-portal-gtk-session>=0"
short_desc="Portal backend service for Flatpak using GTK+"
maintainer="Duncaen <duncaen@voidlinux.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/flatpak/xdg-desktop-portal-gtk"
