#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
UP=$ROOT/.upstream
HOSTDIR=$ROOT/hostdir
# VOIDLAB_ARCH=x86_64-musl builds the musl flavour in its own masterdir and
# repo-musl/ (local only; `publish` is glibc-only).
ARCH=${VOIDLAB_ARCH:-x86_64}
case $ARCH in
x86_64) MASTERDIR=$ROOT/masterdir REPO=$ROOT/repo XSRC_ARCH= ;;
x86_64-musl) MASTERDIR=$ROOT/masterdir-musl REPO=$ROOT/repo-musl XSRC_ARCH=$ARCH ;;
*) echo "voidlab: unsupported VOIDLAB_ARCH: $ARCH" >&2; exit 1 ;;
esac
DIST=$ROOT/dist
# Template folders kept in sibling repos (init-diversity); one dir with a `template` each.
EXTRA_SRCPKGS=${VOIDLAB_EXTRA_SRCPKGS:-$ROOT/../init-diversity}
KEY=${VOIDLAB_KEY:-$HOME/.config/voidlab/privkey.pem}
GH_REPO=${VOIDLAB_GH_REPO:-mendescotta/voidlab}
RELEASE_TAG=${VOIDLAB_RELEASE_TAG:-repo}
UPSTREAM_URL=${VOIDLAB_UPSTREAM_URL:-https://github.com/void-linux/void-packages}

die()  { echo "voidlab: $*" >&2; exit 1; }
need() { local t; for t; do command -v "$t" >/dev/null || die "missing tool: $t"; done; }
need_upstream() { [ -d "$UP/.git" ] || die "no upstream checkout; run: voidlab sync"; }
xsrc() { (cd "$UP" && ./xbps-src ${XSRC_ARCH:+-A "$XSRC_ARCH"} -H "$HOSTDIR" -m "$MASTERDIR" "$@"); }
no_running_build() {
	need pgrep
	if pgrep -x xbps-src >/dev/null; then die "another xbps-src build is running"; fi
}

tmpl_ver() {
	awk -F= '/^version=/ { v = $2 } /^revision=/ { r = $2 }
		END { gsub(/["\047]/, "", v); if (v == "" || r == "" || v ~ /\$/) exit 1; print v "_" r }' "$1"
}

merge_shlibs() {
	local ov=$ROOT/common/shlibs up=$UP/common/shlibs dups
	[ -s "$ov" ] || return 0
	dups=$(awk '!/^#/ && NF { print $1 }' "$ov" | sort | uniq -d)
	[ -z "$dups" ] || die "duplicate SONAME in common/shlibs: $dups"
	awk 'function key(f, p) { sub(/\.so\..*/, ".so", f); sub(/-[^-]+_[0-9]+$/, "", p); return f " " p }
		NR == FNR { if (!/^#/ && NF) { ov[$1] = 1; ovlib[key($1, $2)] = 1 }; next }
		!($1 in ov) && !(NF && key($1, $2) in ovlib)' "$ov" "$up" > "$up.new"
	awk '!/^#/ && NF' "$ov" >> "$up.new"
	mv "$up.new" "$up"
}

cmd_overlay() {
	need_upstream
	no_running_build
	git -C "$UP" reset -q --hard
	git -C "$UP" clean -qfdx
	local p e name
	if [ -f "$ROOT/common/removed-srcpkgs" ]; then
		while read -r p; do
			[ -n "$p" ] && rm -rf "${UP:?}/srcpkgs/$p"
		done < "$ROOT/common/removed-srcpkgs"
	fi
	for e in "$ROOT"/srcpkgs/* "$EXTRA_SRCPKGS"/*/; do
		[ -e "$e" ] || [ -L "$e" ] || continue
		e=${e%/}
		case $e in "$ROOT"/srcpkgs/*) ;; *) [ -f "$e/template" ] || continue ;; esac
		name=${e##*/}
		rm -rf "${UP:?}/srcpkgs/$name"
		if [ -L "$e" ]; then cp -P "$e" "$UP/srcpkgs/$name"; else cp -a "$e" "$UP/srcpkgs/$name"; fi
	done
	merge_shlibs
	for p in "$ROOT"/common/patches/*.patch; do
		[ -e "$p" ] || continue
		git -C "$UP" apply "$p" || die "patch does not apply: ${p##*/}"
	done
}

cmd_sync() {
	need git
	no_running_build
	if [ -d "$UP/.git" ]; then
		git -C "$UP" fetch -q --depth 1 origin master
		git -C "$UP" reset -q --hard FETCH_HEAD
		git -C "$UP" clean -qfdx
	else
		git clone -q --depth 1 "$UPSTREAM_URL" "$UP"
	fi
	if [ -z "${VOIDLAB_NO_BOOTSTRAP:-}" ] && [ ! -d "$MASTERDIR" ]; then
		xsrc binary-bootstrap
	fi
}

index_repo() {
	local marker=$1 f
	mkdir -p "$REPO"
	while IFS= read -r -d '' f; do
		cp "$f" "$REPO/"
	done < <(find "$HOSTDIR/binpkgs" \( -name "*.$ARCH.xbps" -o -name '*.noarch.xbps' \) -newer "$marker" -print0 2>/dev/null)
	shopt -s nullglob
	set -- "$REPO"/*.xbps
	shopt -u nullglob
	[ $# -gt 0 ] || return 0
	XBPS_ARCH=$ARCH xbps-rindex -f -a "$@" >/dev/null
	XBPS_ARCH=$ARCH xbps-rindex -r "$REPO" >/dev/null
}

cmd_build() {
	[ $# -gt 0 ] || die "usage: voidlab build <pkg>..."
	need git xbps-rindex
	need_upstream
	cmd_overlay
	local p log
	for p; do
		[ -f "$UP/srcpkgs/$p/template" ] || die "no such package: $p"
	done
	mkdir -p "$HOSTDIR"
	local marker=$HOSTDIR/.voidlab-build-start
	touch "$marker"
	for p; do
		log=$HOSTDIR/voidlab-build-$p.log
		echo "=> $p"
		xsrc clean "$p" > "$log" 2>&1 || true
		if ! xsrc pkg "$p" >> "$log" 2>&1; then
			tail -n 30 "$log" >&2
			index_repo "$marker"
			die "build failed: $p (full log: $log); earlier packages were indexed"
		fi
	done
	index_repo "$marker"
}

cmd_status() {
	need_upstream
	need xbps-uhelper xbps-query
	local pristine
	pristine=$(mktemp -d)
	trap 'rm -rf "$pristine"' RETURN
	local e p ours theirs verdict rc built
	printf '%-30s %-22s %-22s %-12s %s\n' PACKAGE OURS UPSTREAM VERDICT REPO
	for e in "$ROOT"/srcpkgs/* "$EXTRA_SRCPKGS"/*/; do
		e=${e%/}
		[ -L "$e" ] && continue
		[ -f "$e/template" ] || continue
		p=${e##*/}
		if ! ours=$(tmpl_ver "$e/template"); then
			printf '%-30s %-22s %-22s %s\n' "$p" "?" "-" "unparseable"
			continue
		fi
		theirs=
		if git -C "$UP" cat-file -e "HEAD:srcpkgs/$p/template" 2>/dev/null; then
			theirs=$(git -C "$UP" show "HEAD:srcpkgs/$p/template" | tmpl_ver -) || theirs="?"
		fi
		if [ -z "$theirs" ]; then
			verdict=new
		elif [ "$theirs" = "?" ]; then
			verdict=check
		else
			rc=0; xbps-uhelper cmpver "$ours" "$theirs" || rc=$?
			case $rc in
			1) verdict=ahead ;;
			255) verdict=behind ;;
			*) git -C "$UP" archive HEAD "srcpkgs/$p" | tar -x -C "$pristine"
				if diff -rq "$e" "$pristine/srcpkgs/$p" >/dev/null 2>&1; then
					verdict=redundant; else verdict=same-ver; fi ;;
			esac
		fi
		built=$(xbps-query -i --repository="$REPO" -p pkgver "$p" 2>/dev/null || true)
		if [ -z "$built" ]; then built=unbuilt
		elif [ "$built" = "$p-$ours" ]; then built=ok
		else built="stale(${built#"$p"-})"; fi
		printf '%-30s %-22s %-22s %-12s %s\n' "$p" "$ours" "${theirs:--}" "$verdict" "$built"
	done
}

cmd_keygen() {
	need openssl
	[ ! -e "$KEY" ] || die "key already exists: $KEY"
	mkdir -p "$(dirname "$KEY")"
	(umask 077 && openssl genrsa -out "$KEY" 4096 2>/dev/null)
	echo "created $KEY (keep it private, never commit it)"
}

cmd_publish() {
	need gh xbps-rindex
	[ -f "$KEY" ] || die "no signing key at $KEY; run: voidlab keygen"
	[ "$ARCH" = x86_64 ] || die "publish is glibc-only (VOIDLAB_ARCH=$ARCH)"
	[ -f "$REPO/x86_64-repodata" ] || die "nothing to publish; run: voidlab build <pkg>"
	rm -rf "$DIST"
	mkdir -p "$DIST"
	cp "$REPO"/*.xbps "$REPO/x86_64-repodata" "$DIST/"
	xbps-rindex --privkey "$KEY" --signedby "voidlab <${GH_REPO%%/*}>" --sign "$DIST" >/dev/null
	xbps-rindex --privkey "$KEY" --sign-pkg "$DIST"/*.xbps >/dev/null
	gh release view "$RELEASE_TAG" -R "$GH_REPO" >/dev/null 2>&1 ||
		gh release create "$RELEASE_TAG" -R "$GH_REPO" --prerelease \
			--title "voidlab binary repository" \
			--notes "xbps repository, see README. Updated in place by \`voidlab publish\`."
	local remote f n
	remote=$(gh release view "$RELEASE_TAG" -R "$GH_REPO" --json assets -q '.assets[] | "\(.name) \(.digest)"')
	local up=()
	for f in "$DIST"/*; do
		n=${f##*/}
		case $n in *-repodata) up+=("$f"); continue ;; esac
		grep -qxF "$n sha256:$(sha256sum "$f" | cut -d" " -f1)" <<<"$remote" || up+=("$f")
	done
	echo "=> uploading ${#up[@]} of $(ls "$DIST" | wc -l) files"
	[ ${#up[@]} -eq 0 ] || gh release upload "$RELEASE_TAG" -R "$GH_REPO" --clobber "${up[@]}"
	while read -r n _; do
		[ -n "$n" ] && [ ! -e "$DIST/$n" ] && gh release delete-asset "$RELEASE_TAG" "$n" -R "$GH_REPO" -y
	done <<<"$remote"
	echo "repository: https://github.com/$GH_REPO/releases/download/$RELEASE_TAG"
}

case ${1:-} in
sync)    shift; cmd_sync "$@" ;;
overlay) shift; cmd_overlay "$@" ;;
build)   shift; cmd_build "$@" ;;
status)  shift; cmd_status "$@" ;;
keygen)  shift; cmd_keygen "$@" ;;
publish) shift; cmd_publish "$@" ;;
*) echo "usage: voidlab {sync|overlay|build <pkg>...|status|keygen|publish}" >&2; exit 2 ;;
esac
