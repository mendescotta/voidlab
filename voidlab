#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
UP=$ROOT/.upstream
HOSTDIR=$ROOT/hostdir
# VOIDLAB_ARCH=x86_64-musl builds the musl flavour in its own masterdir and
# repo-musl/ (local only; `publish` is glibc-only).
ARCH=${VOIDLAB_ARCH:-x86_64}
case $ARCH in
x86_64) MASTERDIR=$ROOT/masterdir REPO=$ROOT/repo XSRC_ARCH= ;;
x86_64-musl) MASTERDIR=$ROOT/masterdir-musl REPO=$ROOT/repo-musl XSRC_ARCH=$ARCH ;;
*) echo "voidlab: unsupported VOIDLAB_ARCH: $ARCH" >&2; exit 1 ;;
esac
DIST=$ROOT/dist
# Template folders kept in sibling repos (voidlands); one dir with a `template` each.
EXTRA_SRCPKGS=${VOIDLAB_EXTRA_SRCPKGS:-$ROOT/../voidlands}
KEY=${VOIDLAB_KEY:-$HOME/.config/voidlab/privkey.pem}
GH_REPO=${VOIDLAB_GH_REPO:-mendescotta/voidlab}
RELEASE_TAG=${VOIDLAB_RELEASE_TAG:-repo}
UPSTREAM_URL=${VOIDLAB_UPSTREAM_URL:-https://github.com/void-linux/void-packages}
# How each template is updated: `<pkg> <tier>` per line, `#` comments. Tiers: auto (bump, build, merge,
# publish), review (bump, build, open a PR that you merge), manual (never bumped). Unlisted = notify
# (reported only).
TIERS=${VOIDLAB_TIERS:-$ROOT/tools/update-tiers}
# Templates kept on purpose even when official Void has the same version.
KEEP=${VOIDLAB_KEEP:-$ROOT/tools/keep-overlay.list}
OFFICIAL_URL=${VOIDLAB_OFFICIAL_URL:-https://repo-default.voidlinux.org/current}
# repodata of the published release, stored by `pull`, read by `update`.
RELDIR=$ROOT/.release

die()  { echo "voidlab: $*" >&2; exit 1; }
need() { local t; for t; do command -v "$t" >/dev/null || die "missing tool: $t"; done; }
need_upstream() { [ -d "$UP/.git" ] || die "no upstream checkout; run: voidlab sync"; }
xsrc() { (cd "$UP" && ./xbps-src ${XSRC_ARCH:+-A "$XSRC_ARCH"} -H "$HOSTDIR" -m "$MASTERDIR" "$@"); }
no_running_build() {
	need pgrep
	if pgrep -x xbps-src >/dev/null; then die "another xbps-src build is running"; fi
}

tmpl_ver() {
	awk -F= '/^version=/ { v = $2 } /^revision=/ { r = $2 }
		END { gsub(/["\047]/, "", v); if (v == "" || r == "" || v ~ /\$/) exit 1; print v "_" r }' "$1"
}

merge_shlibs() {
	local ov=$ROOT/common/shlibs up=$UP/common/shlibs dups
	[ -s "$ov" ] || return 0
	dups=$(awk '!/^#/ && NF { print $1 }' "$ov" | sort | uniq -d)
	[ -z "$dups" ] || die "duplicate SONAME in common/shlibs: $dups"
	awk 'function key(f, p) { sub(/\.so\..*/, ".so", f); sub(/-[^-]+_[0-9]+$/, "", p); return f " " p }
		NR == FNR { if (!/^#/ && NF) { ov[$1] = 1; ovlib[key($1, $2)] = 1 }; next }
		!($1 in ov) && !(NF && key($1, $2) in ovlib)' "$ov" "$up" > "$up.new"
	awk '!/^#/ && NF' "$ov" >> "$up.new"
	mv "$up.new" "$up"
}

# `clean -fdx` drops etc/conf, so sync and overlay both rewrite it. CI sets VOIDLAB_CHROOT_CMD
# because unprivileged user namespaces are blocked there.
write_chroot_conf() {
	[ -n "${VOIDLAB_CHROOT_CMD:-}" ] || return 0
	mkdir -p "$UP/etc"
	echo "XBPS_CHROOT_CMD=$VOIDLAB_CHROOT_CMD" > "$UP/etc/conf"
}

cmd_overlay() {
	need_upstream
	no_running_build
	git -C "$UP" reset -q --hard
	git -C "$UP" clean -qfdx
	write_chroot_conf
	local p e name
	if [ -f "$ROOT/common/removed-srcpkgs" ]; then
		while read -r p; do
			[ -n "$p" ] && rm -rf "${UP:?}/srcpkgs/$p"
		done < "$ROOT/common/removed-srcpkgs"
	fi
	for e in "$ROOT"/srcpkgs/* "$EXTRA_SRCPKGS"/*/; do
		[ -e "$e" ] || [ -L "$e" ] || continue
		e=${e%/}
		case $e in "$ROOT"/srcpkgs/*) ;; *) [ -f "$e/template" ] || continue ;; esac
		name=${e##*/}
		rm -rf "${UP:?}/srcpkgs/$name"
		if [ -L "$e" ]; then cp -P "$e" "$UP/srcpkgs/$name"; else cp -a "$e" "$UP/srcpkgs/$name"; fi
	done
	merge_shlibs
	for p in "$ROOT"/common/patches/*.patch; do
		[ -e "$p" ] || continue
		git -C "$UP" apply "$p" || die "patch does not apply: ${p##*/}"
	done
}

cmd_sync() {
	need git
	no_running_build
	if [ -d "$UP/.git" ]; then
		git -C "$UP" fetch -q --depth 1 origin master
		git -C "$UP" reset -q --hard FETCH_HEAD
		git -C "$UP" clean -qfdx
	else
		git clone -q --depth 1 "$UPSTREAM_URL" "$UP"
	fi
	write_chroot_conf
	if [ -z "${VOIDLAB_NO_BOOTSTRAP:-}" ] && [ ! -d "$MASTERDIR" ]; then
		xsrc binary-bootstrap
	fi
}

# rindex_add <file>...: index packages oldest version first. xbps-rindex -f keeps the LAST file of a
# package, and a plain glob sorts _10 before _9, which indexed the older revision and then removed the newer.
rindex_add() {
	local files
	mapfile -t files < <(printf '%s\n' "$@" | sort -V)
	XBPS_ARCH=$ARCH xbps-rindex -f -a "${files[@]}" >/dev/null
}
index_repo() {
	local marker=$1 f
	mkdir -p "$REPO"
	local -A built=()
	local re='^(.+)-[^-]+_[0-9]+\.([^.]+)\.xbps$' g
	while IFS= read -r -d '' f; do
		cp "$f" "$REPO/"
		[[ ${f##*/} =~ $re ]] && built[${BASH_REMATCH[1]}]=${f##*/}
	done < <(find "$HOSTDIR/binpkgs" \( -name "*.$ARCH.xbps" -o -name '*.noarch.xbps' \) -newer "$marker" -print0 2>/dev/null)
	# a build supersedes every other version of that package here, also one that sorts higher: the
	# template may revert it (reverts=), and rindex_add would otherwise index the higher one
	for g in "$REPO"/*.xbps; do
		[[ ${g##*/} =~ $re ]] || continue
		f=${built[${BASH_REMATCH[1]}]:-}
		[ -n "$f" ] && [ "$f" != "${g##*/}" ] && rm -f "$g"
	done
	shopt -s nullglob
	set -- "$REPO"/*.xbps
	shopt -u nullglob
	[ $# -gt 0 ] || return 0
	rindex_add "$@"
	XBPS_ARCH=$ARCH xbps-rindex -r "$REPO" >/dev/null
}

cmd_build() {
	[ $# -gt 0 ] || die "usage: voidlab build <pkg>..."
	need git xbps-rindex
	need_upstream
	cmd_overlay
	local p log
	for p; do
		[ -f "$UP/srcpkgs/$p/template" ] || die "no such package: $p"
	done
	mkdir -p "$HOSTDIR"
	local marker=$HOSTDIR/.voidlab-build-start
	touch "$marker"
	for p; do
		log=$HOSTDIR/voidlab-build-$p.log
		echo "=> $p"
		xsrc clean "$p" > "$log" 2>&1 || true
		if ! xsrc pkg "$p" >> "$log" 2>&1; then
			tail -n 30 "$log" >&2
			index_repo "$marker"
			die "build failed: $p (full log: $log); earlier packages were indexed"
		fi
	done
	index_repo "$marker"
}

cmd_status() {
	need_upstream
	need xbps-uhelper xbps-query
	local pristine
	pristine=$(mktemp -d)
	trap 'rm -rf "$pristine"' RETURN
	local e p ours theirs verdict rc built
	printf '%-30s %-22s %-22s %-12s %s\n' PACKAGE OURS UPSTREAM VERDICT REPO
	for e in "$ROOT"/srcpkgs/* "$EXTRA_SRCPKGS"/*/; do
		e=${e%/}
		[ -L "$e" ] && continue
		[ -f "$e/template" ] || continue
		p=${e##*/}
		if ! ours=$(tmpl_ver "$e/template"); then
			printf '%-30s %-22s %-22s %s\n' "$p" "?" "-" "unparseable"
			continue
		fi
		theirs=
		if git -C "$UP" cat-file -e "HEAD:srcpkgs/$p/template" 2>/dev/null; then
			theirs=$(git -C "$UP" show "HEAD:srcpkgs/$p/template" | tmpl_ver -) || theirs="?"
		fi
		if [ -z "$theirs" ]; then
			verdict=new
		elif [ "$theirs" = "?" ]; then
			verdict=check
		else
			rc=0; xbps-uhelper cmpver "$ours" "$theirs" || rc=$?
			case $rc in
			1) verdict=ahead ;;
			255) verdict=behind ;;
			*) git -C "$UP" archive HEAD "srcpkgs/$p" | tar -x -C "$pristine"
				if diff -rq "$e" "$pristine/srcpkgs/$p" >/dev/null 2>&1; then
					verdict=redundant; else verdict=same-ver; fi ;;
			esac
		fi
		built=$(xbps-query -i --repository="$REPO" -p pkgver "$p" 2>/dev/null || true)
		if [ -z "$built" ]; then built=unbuilt
		elif [ "$built" = "$p-$ours" ]; then built=ok
		else built="stale(${built#"$p"-})"; fi
		printf '%-30s %-22s %-22s %-12s %s\n' "$p" "$ours" "${theirs:--}" "$verdict" "$built"
	done
}

list_names() {
	[ -f "$1" ] || return 0
	sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$1" | awk 'NF'
}

# Path of the overlay template for a package name, or exit 1.
overlay_tmpl() {
	if [ -f "$ROOT/srcpkgs/$1/template" ] && [ ! -L "$ROOT/srcpkgs/$1" ]; then
		echo "$ROOT/srcpkgs/$1/template"
	elif [ -f "$EXTRA_SRCPKGS/$1/template" ]; then
		echo "$EXTRA_SRCPKGS/$1/template"
	else
		return 1
	fi
}

# tier_pairs: validated `pkg tier` lines of $TIERS; a malformed line is an error, never a silent demotion.
tier_pairs() {
	[ -f "$TIERS" ] || return 0
	awk '
		{ sub(/#.*/, "") }
		NF == 0 { next }
		NF != 2 || $2 !~ /^(auto|review|manual)$/ { printf "voidlab: bad line in update-tiers: %s\n", $0 > "/dev/stderr"; bad = 1; next }
		{ print }
		END { exit bad }' "$TIERS"
}
# tier_names <tier>...: names whose tier is one of those given.
tier_names() {
	local pairs
	pairs=$(tier_pairs) || return 1
	awk -v want=" $* " 'index(want, " " $2 " ") { print $1 }' <<<"$pairs"
}
cmd_tiers() {
	local pairs p t
	declare -A tier
	pairs=$(tier_pairs) || exit 1
	while read -r p t; do [ -z "$p" ] || tier[$p]=$t; done <<<"$pairs"
	for p in $(overlay_names | sort); do printf '%s\t%s\n' "$p" "${tier[$p]:-notify}"; done
}
overlay_names() {
	local e
	for e in "$ROOT"/srcpkgs/* "$EXTRA_SRCPKGS"/*/; do
		e=${e%/}
		[ -L "$e" ] && continue
		[ -f "$e/template" ] || continue
		echo "${e##*/}"
	done
}

# Upstream tag names are attacker-controlled and end up in a template that xbps-src sources as
# shell, so a version is only ever accepted if it is plain: no quote, $, `, ;, &, /, \ or space.
VERSION_RE='^[0-9][0-9A-Za-z.+~]*$'

# stdin: `xbps-src update-check` output; prints the highest stable, plain version of $1.
# Lines without `->` (error text), pre-releases and implausible versions are ignored.
latest_stable() {
	awk -v p="$1-" '$2 == "->" { v = $3; if (index(v, p) == 1) v = substr(v, length(p) + 1); print v }' |
		{ grep -E "$VERSION_RE" || true; } |
		{ grep -viE 'alpha|beta|rc|pre|dev|snap|nightly' || true; } | sort -V | tail -n1
}

# Published version_revision of $1 ("" when absent); exit 1 when there is no release index.
release_ver() {
	[ -f "$RELDIR/$ARCH-repodata" ] || return 1
	local v
	v=$(XBPS_ARCH=$ARCH xbps-query -i -R --repository="$RELDIR" -p pkgver "$1" 2>/dev/null || true)
	echo "${v#"$1"-}"
}

# apply_bump <pkg> <overlay template> <new version>: set version, reset revision, regenerate
# the checksum (xgensum runs in the upstream checkout on a copy); restore the template on failure.
apply_bump() {
	local p=$1 t=$2 v=$3 ut=$UP/srcpkgs/$1/template bak
	[[ $v =~ $VERSION_RE ]] || return 1
	bak=$(mktemp)
	cp "$t" "$bak"
	sed -i -e "s/^version=.*/version=$v/" -e 's/^revision=.*/revision=1/' "$t"
	cp "$t" "$ut"
	if [ -n "${VOIDLAB_GENSUM:-}" ]; then
		"$VOIDLAB_GENSUM" "$ut" >/dev/null 2>&1 || { cp "$bak" "$t"; rm -f "$bak"; return 1; }
	else
		(cd "$UP" && XBPS_DISTDIR=$UP XBPS_MASTERDIR=$MASTERDIR xgensum -H "$HOSTDIR" -i "srcpkgs/$p/template") >/dev/null 2>&1 ||
			{ cp "$bak" "$t"; rm -f "$bak"; return 1; }
	fi
	cp "$ut" "$t"
	rm -f "$bak"
}

# update [--check] [--all] [pkg...]: TSV `status pkg ours other`, status bump|current|unpublished|fail.
cmd_update() {
	need xbps-uhelper
	local check= all= p t ours cur new newer out rel rc pkgs=()
	while [ $# -gt 0 ]; do
		case $1 in
		--check) check=1 ;;
		--all) all=1; check=1 ;;
		-*) die "update: unknown option: $1" ;;
		*) pkgs+=("$1") ;;
		esac
		shift
	done
	need_upstream
	# release_only[pkg]: a template outside the auto/review tiers, listed by the default run only to
	# find what main has that the release lacks: no upstream check, never a bump
	local -A release_only=()
	if [ ${#pkgs[@]} -eq 0 ]; then
		if [ -n "$all" ]; then
			mapfile -t pkgs < <(overlay_names)
		else
			out=$(tier_names auto review) || exit 1
			[ -z "$out" ] || mapfile -t pkgs <<<"$out"
			if [ -f "$RELDIR/$ARCH-repodata" ]; then
				local -A tiered=()
				for p in "${pkgs[@]}"; do tiered[$p]=1; done
				while IFS= read -r p; do
					[ -n "$p" ] && [ -z "${tiered[$p]:-}" ] && { release_only[$p]=1; pkgs+=("$p"); }
				done < <(overlay_names)
			fi
		fi
	fi
	cmd_overlay
	for p in "${pkgs[@]}"; do
		if ! t=$(overlay_tmpl "$p"); then printf 'fail\t%s\t-\tno overlay template\n' "$p"; continue; fi
		if ! ours=$(tmpl_ver "$t"); then printf 'fail\t%s\t-\tunparseable template\n' "$p"; continue; fi
		cur=${ours%_*}
		if [ -n "${release_only[$p]:-}" ]; then
			out=
		elif ! out=$(cd "$UP" && ./xbps-src update-check "$p" 2>&1); then
			printf 'fail\t%s\t%s\tupdate-check failed\n' "$p" "$ours"; continue
		fi
		new=$(latest_stable "$p" <<<"$out")
		if [ -n "$new" ] && ! [[ $new =~ $VERSION_RE ]]; then
			printf 'fail\t%s\t%s\tinvalid upstream version\n' "$p" "$ours"; continue
		fi
		newer=
		if [ -n "$new" ]; then
			rc=0; xbps-uhelper cmpver "$new" "$cur" || rc=$?
			if [ "$rc" -eq 1 ]; then newer=1; fi
		fi
		if [ -n "$newer" ]; then
			printf 'bump\t%s\t%s\t%s\n' "$p" "$ours" "$new"
			if [ -z "$check" ] && ! apply_bump "$p" "$t" "$new"; then
				printf 'fail\t%s\t%s\tchecksum regeneration failed\n' "$p" "$ours"
			fi
			continue
		fi
		if rel=$(release_ver "$p"); then
			rc=1
			[ -z "$rel" ] || { rc=0; xbps-uhelper cmpver "$ours" "$rel" || rc=$?; }
			# a template whose reverts= lists the published version replaces it, as xbps treats it
			if [ "$rc" -ne 1 ] && [ -n "$rel" ] &&
				grep -qxF -- "$rel" <<<"$(sed -n 's/^reverts=//p' "$t" | tr -d "\"'" | tr -s ' \t' '\n')"; then rc=1; fi
			if [ "$rc" -eq 1 ]; then printf 'unpublished\t%s\t%s\t%s\n' "$p" "$ours" "${rel:--}"; continue; fi
		fi
		printf 'current\t%s\t%s\t-\n' "$p" "$ours"
	done
}

# test <pkg>...: the built package matches its template and installs (dry run) from repo/ + official Void.
cmd_test() {
	[ $# -gt 0 ] || die "usage: voidlab test <pkg>..."
	need xbps-install xbps-query xlint
	local p t ver built lint root rc=0 xi
	root=$(mktemp -d)
	trap 'rm -rf "$root"' RETURN
	mkdir -p "$root/conf" "$root/rootfs/var/db/xbps/keys"
	echo 'bestmatching=true' > "$root/conf/00-voidlab.conf"
	cp /var/db/xbps/keys/*.plist "$root/rootfs/var/db/xbps/keys/" 2>/dev/null || true
	# -n skips the index sync, and a remote repo is invisible until it is synced
	xi=(-C "$root/conf" -r "$root/rootfs" --repository="$REPO" --repository="$OFFICIAL_URL")
	# -y does not answer the "import this public key?" prompt, so answer it on stdin
	printf 'y\n' | XBPS_ARCH=$ARCH xbps-install -S -y "${xi[@]}" > "$root/sync.log" 2>&1 ||
		die "test: cannot sync repositories: $(tail -n 3 "$root/sync.log" | tr '\n' ' ')"
	for p; do
		if ! t=$(overlay_tmpl "$p"); then echo "FAIL $p: no overlay template"; rc=1; continue; fi
		if ! ver=$(tmpl_ver "$t"); then echo "FAIL $p: unparseable template"; rc=1; continue; fi
		built=$(XBPS_ARCH=$ARCH xbps-query -i -R --repository="$REPO" -p pkgver "$p" 2>/dev/null || true)
		built=${built#"$p"-}
		if [ -z "$built" ]; then echo "FAIL $p: not built"; rc=1; continue; fi
		if [ "$built" != "$ver" ]; then echo "FAIL $p: built $built, template says $ver"; rc=1; continue; fi
		lint=$(xlint "$t" 2>&1 || true)
		[ -z "$lint" ] || printf 'warn %s: xlint\n%s\n' "$p" "$lint"
		if XBPS_ARCH=$ARCH xbps-install -n -y "${xi[@]}" "$p" > "$root/log" 2>&1; then
			echo "ok $p"
		else
			echo "FAIL $p: dry-run install failed: $(tail -n 3 "$root/log" | tr '\n' ' ')"
			rc=1
		fi
	done
	return "$rc"
}

# pull: seed repo/ with the published release (so `publish` does not delete what we did not build)
# and keep its repodata in .release/ for `update`'s unpublished check.
cmd_pull() {
	need gh xbps-rindex
	[ "$ARCH" = x86_64 ] || die "pull is glibc-only (VOIDLAB_ARCH=$ARCH)"
	local tmp f n new=()
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' RETURN
	gh release download "$RELEASE_TAG" -R "$GH_REPO" -D "$tmp" --pattern '*.xbps' --pattern '*-repodata' --clobber ||
		die "pull: cannot download release $RELEASE_TAG of $GH_REPO"
	[ -f "$tmp/x86_64-repodata" ] || die "pull: release $RELEASE_TAG has no x86_64-repodata"
	mkdir -p "$REPO" "$RELDIR"
	cp "$tmp/x86_64-repodata" "$RELDIR/"
	shopt -s nullglob
	for f in "$tmp"/*.xbps; do
		n=${f##*/}
		[ -e "$REPO/$n" ] && continue
		cp "$f" "$REPO/"
		new+=("$REPO/$n")
	done
	shopt -u nullglob
	if [ ${#new[@]} -gt 0 ]; then
		rindex_add "${new[@]}"
		XBPS_ARCH=$ARCH xbps-rindex -r "$REPO" >/dev/null
	fi
	echo "=> pulled ${#new[@]} packages"
}

# redundant: overlay templates at the same version as, or behind, official Void (prefer official),
# minus tools/keep-overlay.list. TSV `verdict pkg ours official`; verdict identical|revbump|same-ver|behind.
cmd_redundant() {
	need_upstream
	need xbps-uhelper
	local pristine p t e ours theirs rc verdict keep
	pristine=$(mktemp -d)
	trap 'rm -rf "$pristine"' RETURN
	keep=$(list_names "$KEEP")
	while IFS= read -r p; do
		if grep -qxF "$p" <<<"$keep"; then continue; fi
		t=$(overlay_tmpl "$p")
		e=${t%/template}
		ours=$(tmpl_ver "$t") || continue
		git -C "$UP" cat-file -e "HEAD:srcpkgs/$p/template" 2>/dev/null || continue
		theirs=$(git -C "$UP" show "HEAD:srcpkgs/$p/template" | tmpl_ver -) || continue
		rc=0; xbps-uhelper cmpver "${ours%_*}" "${theirs%_*}" || rc=$?
		case $rc in
		1) continue ;;
		255) printf 'behind\t%s\t%s\t%s\n' "$p" "$ours" "$theirs"; continue ;;
		esac
		rm -rf "${pristine:?}/srcpkgs"
		git -C "$UP" archive HEAD "srcpkgs/$p" | tar -x -C "$pristine"
		if diff -rq -I '^revision=' "$e" "$pristine/srcpkgs/$p" >/dev/null 2>&1; then
			if [ "$ours" = "$theirs" ]; then verdict=identical; else verdict=revbump; fi
		else
			verdict=same-ver
		fi
		printf '%s\t%s\t%s\t%s\n' "$verdict" "$p" "$ours" "$theirs"
	done < <(overlay_names)
}

cmd_keygen() {
	need openssl
	[ ! -e "$KEY" ] || die "key already exists: $KEY"
	mkdir -p "$(dirname "$KEY")"
	(umask 077 && openssl genrsa -out "$KEY" 4096 2>/dev/null)
	echo "created $KEY (keep it private, never commit it)"
}

cmd_publish() {
	need gh xbps-rindex
	[ -f "$KEY" ] || die "no signing key at $KEY; run: voidlab keygen"
	[ "$ARCH" = x86_64 ] || die "publish is glibc-only (VOIDLAB_ARCH=$ARCH)"
	[ -f "$REPO/x86_64-repodata" ] || die "nothing to publish; run: voidlab build <pkg>"
	rm -rf "$DIST"
	mkdir -p "$DIST"
	for _f in "$REPO"/*.xbps; do
		case ${_f##*/} in nvidia-*) continue ;; esac
		cp "$_f" "$DIST/"
	done
	cp "$REPO/x86_64-repodata" "$DIST/"
	xbps-rindex --privkey "$KEY" --signedby "voidlab <${GH_REPO%%/*}>" --sign "$DIST" >/dev/null
	xbps-rindex --privkey "$KEY" --sign-pkg "$DIST"/*.xbps >/dev/null
	gh release view "$RELEASE_TAG" -R "$GH_REPO" >/dev/null 2>&1 ||
		gh release create "$RELEASE_TAG" -R "$GH_REPO" --prerelease \
			--title "voidlab binary repository" \
			--notes "xbps repository, see README. Updated in place by \`voidlab publish\`."
	local remote f n
	remote=$(gh release view "$RELEASE_TAG" -R "$GH_REPO" --json assets -q '.assets[] | "\(.name) \(.digest)"')
	local up=()
	for f in "$DIST"/*; do
		n=${f##*/}
		case $n in *-repodata) up+=("$f"); continue ;; esac
		grep -qxF "$n sha256:$(sha256sum "$f" | cut -d" " -f1)" <<<"$remote" || up+=("$f")
	done
	echo "=> uploading ${#up[@]} of $(ls "$DIST" | wc -l) files"
	[ ${#up[@]} -eq 0 ] || gh release upload "$RELEASE_TAG" -R "$GH_REPO" --clobber "${up[@]}"
	while read -r n _; do
		[ -n "$n" ] && [ ! -e "$DIST/$n" ] && gh release delete-asset "$RELEASE_TAG" "$n" -R "$GH_REPO" -y
	done <<<"$remote"
	echo "repository: https://github.com/$GH_REPO/releases/download/$RELEASE_TAG"
}

# packages [--no-upstream]: Markdown table of every overlay template: our version, official Void's, newest
# upstream release (xbps-src update-check; slow, skipped by --no-upstream). Stdout; see packages.md.
cmd_packages() {
	need_upstream
	need xbps-uhelper
	local noup= p t ours theirs new out tier rc pairs mark why keep
	[ "${1:-}" = "--no-upstream" ] && noup=1
	pairs=$(tier_pairs) || exit 1
	keep=$([ -f "$KEEP" ] && sed -n 's/^\([^#[:space:]][^[:space:]]*\)[[:space:]]*#[[:space:]]*\(.*\)$/\1\t\2/p' "$KEEP")
	[ -n "$noup" ] || cmd_overlay >&2
	echo "# Packages"
	echo
	echo "Generated by \`./voidlab packages\` on $(date -u +%F) against official Void as of $(git -C "$UP" log -1 --format=%cd --date=short)."
	echo "Versions are \`version_revision\`. **Void** is blank when official Void does not ship the package;"
	echo "**Upstream** is the newest stable release found by \`xbps-src update-check\` (\`-\` if it cannot tell)."
	echo "Tier is the auto-update tier (see docs/ci.md). ⬆ marks a newer upstream release; a few hits are different series, not updates (gtkmm 3 vs 4, gcr 3 vs 4, ibus date versions)."
	echo
	echo "**Why carried** says why we ship the package: not in Void, newer than Void, or (same version) the reason from"
	echo "\`tools/keep-overlay.list\`. A bold entry needs attention."
	echo
	echo "| Package | Voidlab | Void | Upstream | Tier | Why carried |"
	echo "|---|---|---|---|---|---|"
	while IFS= read -r p; do
		t=$(overlay_tmpl "$p")
		ours=$(tmpl_ver "$t") || ours="?"
		theirs=
		if git -C "$UP" cat-file -e "HEAD:srcpkgs/$p/template" 2>/dev/null; then
			theirs=$(git -C "$UP" show "HEAD:srcpkgs/$p/template" | tmpl_ver -) || theirs="?"
		fi
		new=-
		if [ -z "$noup" ] && out=$(cd "$UP" && ./xbps-src update-check "$p" 2>&1); then
			new=$(latest_stable "$p" <<<"$out")
			if [ -z "$new" ]; then new=${ours%_*}; fi
		fi
		tier=$(awk -v p="$p" '$1 == p { print $2 }' <<<"$pairs")
		mark=
		if [ "$new" != - ]; then
			rc=0; xbps-uhelper cmpver "${ours%_*}" "$new" || rc=$?
			[ "$rc" -eq 255 ] && mark=" ⬆"
		fi
		if [ -z "$theirs" ]; then why="not in Void"
		else
			rc=0; xbps-uhelper cmpver "${ours%_*}" "${theirs%_*}" || rc=$?
			case $rc in
			1) why="newer than Void" ;;
			255) why="**behind Void: drop it**" ;;
			*) why=$(awk -F'\t' -v p="$p" '$1 == p { print $2 }' <<<"$keep")
				[ -n "$why" ] || why="**same version as Void, no reason listed**" ;;
			esac
		fi
		printf '| %s | %s | %s | %s%s | %s | %s |\n' "$p" "$ours" "$theirs" "$new" "$mark" "${tier:-notify}" "$why"
	done < <(overlay_names | sort)
}

case ${1:-} in
sync)    shift; cmd_sync "$@" ;;
overlay) shift; cmd_overlay "$@" ;;
build)   shift; cmd_build "$@" ;;
status)  shift; cmd_status "$@" ;;
keygen)  shift; cmd_keygen "$@" ;;
publish) shift; cmd_publish "$@" ;;
update)  shift; cmd_update "$@" ;;
test)    shift; cmd_test "$@" ;;
pull)    shift; cmd_pull "$@" ;;
redundant) shift; cmd_redundant "$@" ;;
tiers)   shift; cmd_tiers "$@" ;;
packages) shift; cmd_packages "$@" ;;
*) echo "usage: voidlab {sync|overlay|build <pkg>...|status|update|test <pkg>...|pull|redundant|tiers|packages|keygen|publish}" >&2; exit 2 ;;
esac
